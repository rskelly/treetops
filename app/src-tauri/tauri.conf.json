{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treetops",
  "version": "0.1.0",
  "identifier": "ca.dijital.treetops",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run prepare-sidecar",
    "beforeBuildCommand": "npm run prepare-sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Treetops",
        "width": 980,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/treetops-cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
