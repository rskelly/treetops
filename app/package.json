{
  "name": "treetops-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check-rust": "bash scripts/check-rust.sh",
    "prepare-sidecar": "bash scripts/prepare-sidecar.sh",
    "build:cli": "bash ../packaging/linux/build.sh",
    "package:linux": "bash ../packaging/linux/build-gui.sh",
    "package:windows": "pwsh -File ../packaging/windows/build-installer.ps1",
    "dev": "npm run check-rust && npm run prepare-sidecar && tauri dev",
    "build": "npm run check-rust && npm run prepare-sidecar && tauri build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
